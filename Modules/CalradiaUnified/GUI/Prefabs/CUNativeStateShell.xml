<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <!-- Opt-in CU identity ribbon inside REAL CharacterCreationScreen.
         No buttons, input restrictions or fake character tableau.
         Its background is placed in the upper-right viewport region.
         Native culture and FaceGen own every input and stage transition. -->
    <Widget WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent"
            DoNotPassEventsToChildren="false">
      <Children>
        <Widget WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                IsVisible="@IsNotFaceStage">
          <Children>
        <Widget Sprite="BlankWhiteSquare_9" Color="#07111FE8"
                WidthSizePolicy="Fixed" SuggestedWidth="430"
                HeightSizePolicy="Fixed" SuggestedHeight="182"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                PositionXOffset="-20" PositionYOffset="18"/>
        <Widget Sprite="BlankWhiteSquare_9" Color="#C79B5EFF"
                WidthSizePolicy="Fixed" SuggestedWidth="430"
                HeightSizePolicy="Fixed" SuggestedHeight="3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                PositionXOffset="-20" PositionYOffset="18"/>
        <TextWidget Text="@Title" Color="#FFE2ABFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="25"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="29"/>
        <TextWidget Text="@Chapter" Color="#FCEBD0FF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="24"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="56"/>
        <TextWidget Text="@NativeStep" Color="#E8C17DFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="24"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="79"/>
        <TextWidget Text="@Culture" Color="#DDE4EDFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="23"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="103"/>
        <TextWidget Text="@Role" Color="#DDE4EDFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="23"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="125"/>
        <TextWidget Text="@Household" Color="#FCEBD0FF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="23"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="147"/>
        <TextWidget Text="@Notice" Color="#BAC8D9FF"
                    WidthSizePolicy="Fixed" SuggestedWidth="402"
                    HeightSizePolicy="Fixed" SuggestedHeight="32"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    PositionXOffset="-34" PositionYOffset="169"/>
          </Children>
        </Widget>
        <!-- Hide chapter tracker during optional real FaceGen right-dock trial
             so it never blocks the original native face sliders. -->
        <Widget WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                IsVisible="@IsRailVisible">
          <Children>
        <!-- Persistent five-chapter stage tracker inside real CharacterCreationState.
             Read-only. Native stage manager retains all input and callbacks. -->
        <Widget Sprite="BlankWhiteSquare_9" Color="#08131BCB"
                WidthSizePolicy="Fixed" SuggestedWidth="232"
                HeightSizePolicy="Fixed" SuggestedHeight="391"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                PositionXOffset="13" PositionYOffset="115"/>
        <TextWidget Text="CALRADIA UNIFIED | FIVE CHAPTERS"
                Color="#F5D4A0FF"
                WidthSizePolicy="Fixed" SuggestedWidth="218"
                HeightSizePolicy="Fixed" SuggestedHeight="33"
                PositionXOffset="21" PositionYOffset="127"/>
        <ListPanel DataSource="{Chapters}"
                WidthSizePolicy="Fixed" SuggestedWidth="218"
                HeightSizePolicy="Fixed" SuggestedHeight="293"
                StackLayout.LayoutMethod="VerticalTopToBottom"
                PositionXOffset="21" PositionYOffset="163">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="218"
                    HeightSizePolicy="Fixed" SuggestedHeight="55">
              <Children>
                <Widget Sprite="BlankWhiteSquare_9" Color="#B8915CFF"
                        IsVisible="@IsSelected"
                        WidthSizePolicy="Fixed" SuggestedWidth="4"
                        HeightSizePolicy="StretchToParent"/>
                <TextWidget Text="@Label" Color="#E4D4BCFF"
                        WidthSizePolicy="Fixed" SuggestedWidth="202"
                        HeightSizePolicy="Fixed" SuggestedHeight="27"
                        PositionXOffset="8" PositionYOffset="2"/>
                <TextWidget Text="@Status" Color="#9EB3C9FF"
                        WidthSizePolicy="Fixed" SuggestedWidth="202"
                        HeightSizePolicy="Fixed" SuggestedHeight="22"
                        PositionXOffset="8" PositionYOffset="29"/>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>
        <TextWidget Text="STAGE TRACKER | NATIVE CALLBACKS"
                Color="#CEB280FF"
                WidthSizePolicy="Fixed" SuggestedWidth="220"
                HeightSizePolicy="Fixed" SuggestedHeight="25"
                PositionXOffset="20" PositionYOffset="470"/>
          </Children>
        </Widget>
        <TextWidget Text="@ViewportCapability"
                IsVisible="@IsFaceDebugVisible"
                Color="#B2C7D9FF"
                WidthSizePolicy="Fixed" SuggestedWidth="410"
                HeightSizePolicy="Fixed" SuggestedHeight="50"
                PositionXOffset="17" PositionYOffset="513"/>
        <!-- Keep native FaceGen's right-hand sliders and real 3D scene
             unobscured. This verifies active engine-owned layers; it does
             not claim the full-screen scene has been moved to a rectangle. -->
        <Widget Sprite="BlankWhiteSquare_9" Color="#07111FD8"
                IsVisible="@IsFaceDebugVisible"
                WidthSizePolicy="Fixed" SuggestedWidth="465"
                HeightSizePolicy="Fixed" SuggestedHeight="90"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                PositionXOffset="16" PositionYOffset="15"/>
        <TextWidget Text="CALRADIA UNIFIED  |  REAL FACE EDITOR"
                IsVisible="@IsFaceDebugVisible" Color="#F6D7A5FF"
                WidthSizePolicy="Fixed" SuggestedWidth="440"
                HeightSizePolicy="Fixed" SuggestedHeight="30"
                PositionXOffset="27" PositionYOffset="22"/>
        <TextWidget Text="@FaceStatus"
                IsVisible="@IsFaceDebugVisible" Color="#C4D7E8FF"
                WidthSizePolicy="Fixed" SuggestedWidth="440"
                HeightSizePolicy="Fixed" SuggestedHeight="42"
                PositionXOffset="27" PositionYOffset="51"/>
        <!-- F9 restore is a real native scene/view rollback, not a fake
             decorative character model. -->
        <TextWidget Text="@FaceDockStatus"
                IsVisible="@IsFaceDockTrialStage"
                Color="#F2D4A4FF"
                WidthSizePolicy="Fixed" SuggestedWidth="490"
                HeightSizePolicy="Fixed" SuggestedHeight="43"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                PositionXOffset="-20" PositionYOffset="25"/>
      </Children>
    </Widget>
  </Window>
</Prefab>
