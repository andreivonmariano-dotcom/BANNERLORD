<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CalradiaUnified</AssemblyName>
    <Version>0.74.0</Version>
    <AssemblyVersion>0.74.0.0</AssemblyVersion>
    <FileVersion>0.74.0.0</FileVersion>
    <InformationalVersion>0.74.0-acceptance</InformationalVersion>
    <RootNamespace>CalradiaUnified</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <UsePublicReferences Condition="'$(UsePublicReferences)' == ''">false</UsePublicReferences>
  </PropertyGroup>
  <!-- Gauntlet's mouse positions use System.Numerics.Vector2.
       Resolve its net472 compile facade from NuGet. The game already
       supplies the runtime assembly, so do not bundle another copy. -->
  <ItemGroup>
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0"
      PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- UIExtenderEx is a REQUIRED runtime mod, not a vendored DLL.
       Build against its real 3.0.3 public API; installed module supplies
       runtime binaries and MCM/ButterLib/Harmony dependencies. -->
  <ItemGroup>
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="3.0.3"
       PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Bannerlord.UIExtenderEx.Analyzers" Version="3.0.3.9"
       PrivateAssets="all" />
    <PackageReference Include="Bannerlord.MCM" Version="5.13.1"
       PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- Built-in .NET ZIP support, no third-party runtime DLL. -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <!-- Retired pre-MCM settings UI and discarded launcher prototype.
       Keep source for historical audits, not runtime discovery. -->
  <ItemGroup>
    <Compile Remove="SandboxOriginPanel.cs" />
    <Compile Remove="NativeSettingsBehavior.cs" />
    <Compile Remove="NativeSettingsPanel.cs" />
    <!-- Historical gameplay adapters: retained for provenance and old source tests, never compiled. -->
    <Compile Remove="CivicBehavior.cs" />
    <Compile Remove="CivicBehavior.CastleManagement.cs" />
    <Compile Remove="CivicBehavior.Convoys.cs" />
    <Compile Remove="CivicBehavior.Feudal.cs" />
    <Compile Remove="CivicBehavior.Garrisons.cs" />
    <Compile Remove="CivicBehavior.Kingdom.cs" />
    <Compile Remove="CivicBehavior.Trade.cs" />
    <Compile Remove="KingdomAutonomyBehavior.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublicReferences)' == 'true'">
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.5.7.125802" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidateBannerlordReferences" BeforeTargets="ResolveReferences" Condition="'$(UsePublicReferences)' != 'true'">
    <Error Condition="'$(BannerlordGameDir)'==''" Text="Specify -p:BannerlordGameDir=the 1.5.7 game root." />
    <Error Condition="!Exists('$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')" Text="Game reference TaleWorlds.CampaignSystem.dll was not found. Choose the Bannerlord game root." />
  </Target>
  <ItemGroup Condition="'$(UsePublicReferences)' != 'true'">
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Core.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox.View"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\SandBox.View.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ModuleManager"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.ModuleManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox.GauntletUI"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\SandBox.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.InputSystem"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.SaveSystem" Condition="Exists('$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.SaveSystem.dll')"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.SaveSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine" Condition="Exists('$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll')"><HintPath>$(BannerlordGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
