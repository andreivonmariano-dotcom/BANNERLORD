<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <!-- The genuine CharacterCreationCultureStage and its native VM stay
         underneath. This opt-in focused CU panel delegates to them.
         A full opaque backdrop prevents the old native culture UI showing
         through the new CU controls. No duplicate native stage is created. -->
    <Widget WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent">
      <Children>
        <!-- The native culture panel shares the full-bleed CU Sandbox
             visual language. Native stage view and VM remain underneath. -->
        <Widget Sprite="BlankWhiteSquare_9" Color="#09121DFF"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"/>
        <Widget Sprite="BlankWhiteSquare_9" Color="#111F2BF0"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed" SuggestedHeight="100"
                VerticalAlignment="Top"/>
        <Widget Sprite="BlankWhiteSquare_9" Color="#C19B62FF"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed" SuggestedHeight="2"
                VerticalAlignment="Top" PositionYOffset="101"/>
        <Widget Sprite="BlankWhiteSquare_9" Color="#152433F0"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed" SuggestedHeight="92"
                VerticalAlignment="Bottom"/>
        <Widget Sprite="BlankWhiteSquare_9" Color="#B99361FF"
                WidthSizePolicy="StretchToParent"
                HeightSizePolicy="Fixed" SuggestedHeight="2"
                VerticalAlignment="Bottom" PositionYOffset="-94"/>
        <Widget WidthSizePolicy="StretchToParent" MaxWidth="1820"
                MarginLeft="24" MarginRight="24"
                HeightSizePolicy="StretchToParent" MaxHeight="960"
                MarginTop="20" MarginBottom="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget Sprite="BlankWhiteSquare_9" Color="#09121DFF"
                    WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="StretchToParent"/>
            <Widget Sprite="BlankWhiteSquare_9" Color="#CBA36BFF"
                    WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="Fixed" SuggestedHeight="3"
                    PositionYOffset="74"/>
            <TextWidget Text="@Title" Color="#EBC68EFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="810"
                    HeightSizePolicy="Fixed" SuggestedHeight="35"
                    PositionXOffset="28" PositionYOffset="16"/>
            <TextWidget Text="@Subtitle" Color="#EBEFF4FF"
                    WidthSizePolicy="Fixed" SuggestedWidth="770"
                    HeightSizePolicy="Fixed" SuggestedHeight="27"
                    PositionXOffset="29" PositionYOffset="48"/>
            <Widget Sprite="BlankWhiteSquare_9" Color="#0F1F2EEC"
                    WidthSizePolicy="Fixed" SuggestedWidth="442"
                    HeightSizePolicy="StretchToParent" MarginTop="97" MarginBottom="122"
                    PositionXOffset="24"/>
            <TextWidget Text="CULTURES AVAILABLE IN THIS CAMPAIGN"
                    Color="#E8BB7FFF"
                    WidthSizePolicy="Fixed" SuggestedWidth="415"
                    HeightSizePolicy="Fixed" SuggestedHeight="30"
                    PositionXOffset="39" PositionYOffset="111"/>
            <ListPanel DataSource="{Cultures}"
                    WidthSizePolicy="Fixed" SuggestedWidth="415"
                    HeightSizePolicy="Fixed" SuggestedHeight="422"
                    StackLayout.LayoutMethod="VerticalBottomToTop"
                    PositionXOffset="39" PositionYOffset="146">
              <ItemTemplate>
                <ButtonWidget Brush="ButtonBrush"
                    DoNotPassEventsToChildren="true"
                    UpdateChildrenStates="true"
                    WidthSizePolicy="Fixed" SuggestedWidth="405"
                    HeightSizePolicy="Fixed" SuggestedHeight="56"
                    IsSelected="@IsSelected"
                    Command.Click="ExecuteSelect">
                  <Children>
                    <Widget Sprite="BlankWhiteSquare_9"
                            Color="#C8A269FF"
                            IsVisible="@IsSelected"
                            WidthSizePolicy="Fixed" SuggestedWidth="6"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Left"/>
                    <TextWidget Text="@Name" Color="#FFE7C5FF"
                            WidthSizePolicy="Fixed" SuggestedWidth="310"
                            HeightSizePolicy="StretchToParent"
                            PositionXOffset="16"
                            VerticalAlignment="Center"/>
                    <TextWidget Text="@CultureId" Color="#AFC2D4FF"
                            WidthSizePolicy="Fixed" SuggestedWidth="78"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </ListPanel>
            <Widget Sprite="BlankWhiteSquare_9" Color="#1C2A38FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="484" MarginRight="38"
                    HeightSizePolicy="StretchToParent" MarginTop="97" MarginBottom="122"/>
            <TextWidget Text="YOUR CULTURE"
                    Color="#CFA66EFF"
                    WidthSizePolicy="StretchToParent" MarginLeft="507" MarginRight="43"
                    HeightSizePolicy="Fixed" SuggestedHeight="26" PositionYOffset="113"/>
            <TextWidget Text="@SelectedName" Color="#FFEBD1FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="507" MarginRight="63"
                    HeightSizePolicy="Fixed" SuggestedHeight="66" PositionYOffset="155"/>
            <TextWidget Text="@SelectedDescription" Color="#E8E8E8FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="508" MarginRight="65"
                    HeightSizePolicy="Fixed" SuggestedHeight="227" PositionYOffset="239"/>
            <TextWidget Text="@Notice" Color="#ACC2D9FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="510" MarginRight="71"
                    HeightSizePolicy="Fixed" SuggestedHeight="70" PositionYOffset="473"/>
            <Widget Sprite="BlankWhiteSquare_9" Color="#2B3949FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="26" MarginRight="37"
                    HeightSizePolicy="Fixed" SuggestedHeight="2" PositionYOffset="595"/>
            <TextWidget Text="@Status" Color="#F6D5A6FF"
                    WidthSizePolicy="StretchToParent" MarginLeft="29" MarginRight="131"
                    HeightSizePolicy="Fixed" SuggestedHeight="28" PositionYOffset="602"/>
            <ButtonWidget Brush="ButtonBrush"
                    DoNotPassEventsToChildren="true"
                    UpdateChildrenStates="true"
                    WidthSizePolicy="Fixed" SuggestedWidth="214"
                    HeightSizePolicy="Fixed" SuggestedHeight="46"
                    PositionXOffset="27" VerticalAlignment="Bottom" PositionYOffset="-9"
                    Command.Click="ExecuteBack">
              <Children>
                <TextWidget Text="Back to main menu"
                            Color="#F4E3C5FF"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
              </Children>
            </ButtonWidget>
            <ButtonWidget Brush="ButtonBrush"
                    DoNotPassEventsToChildren="true"
                    UpdateChildrenStates="true"
                    WidthSizePolicy="Fixed" SuggestedWidth="235"
                    HeightSizePolicy="Fixed" SuggestedHeight="46"
                    PositionXOffset="262" VerticalAlignment="Bottom" PositionYOffset="-9"
                    Command.Click="ExecuteUseNativeControls">
              <Children>
                <TextWidget Text="Use native culture UI"
                            Color="#F4E8D5FF"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
              </Children>
            </ButtonWidget>
            <ButtonWidget Brush="ButtonBrush"
                    DoNotPassEventsToChildren="true"
                    UpdateChildrenStates="true"
                    WidthSizePolicy="Fixed" SuggestedWidth="265"
                    HeightSizePolicy="Fixed" SuggestedHeight="46"
                    HorizontalAlignment="Right" PositionXOffset="-52" VerticalAlignment="Bottom" PositionYOffset="-9"
                    Command.Click="ExecuteContinue">
              <Children>
                <TextWidget Text="Continue to real 3D face"
                            Color="#FFE0B0FF"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
